# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/sani-ul-website?retryWrites=true&w=majority

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Resend (Email)
RESEND_API_KEY=re_your_api_key
CONTACT_EMAIL=your-email@example.com

# Google Apps Script
GOOGLE_APPS_SCRIPT_URL=your_google_apps_script_url_here

# Admin (generate hash: node -e "require('bcryptjs').hash('your-password', 12).then(h=>console.log(h))")
ADMIN_EMAIL=your-email@example.com
ADMIN_PASSWORD_HASH=your_bcrypt_hash_here

# Auth
JWT_SECRET=generate-a-random-secret-string-here

# Seed
SEED_SECRET=your-secret-seed-key

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
